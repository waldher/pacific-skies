diff --git a/src/airframe-hull.js b/src/airframe-hull.js
new file mode 100644
index 0000000..a25c500
--- /dev/null
+++ b/src/airframe-hull.js
@@ -0,0 +1,81 @@
+import * as THREE from 'three';
+
+// Dorsal stations in model metres, behind the canopy and ahead of the fin.
+// The Lightning's cockpit pod ends early; its starboard boom carries the gauge.
+const stations = {
+  F4U_Corsair: [10.16, 0, 5.58, 7.46, .30],
+  P38_Lightning: [11.5316, 2.45, 5.54, 8.14, .11],
+  SBD_Dauntless: [9.9568, 0, 6.06, 7.13, .25],
+  TBF_Avenger: [12.4714, 0, 6.55, 8.35, .24],
+  P51_Mustang: [9.8298, 0, 5.61, 6.94, .24],
+  Mitsubishi_Zero: [9.06, 0, 4.45, 6.89, .22],
+};
+
+const cells = 4;
+export function bakeAirframeHull(airframe, name) {
+  const [length, center, start, end, halfWidth] = stations[name];
+  const ray = new THREE.Raycaster(new THREE.Vector3(), new THREE.Vector3(0, -1, 0));
+  airframe.updateWorldMatrix(true, true);
+  const positions = [], gaugeUV = [], indices = [];
+  for (let cell = 0; cell < cells; cell++) {
+    const rows = 4;
+    const base = positions.length / 3;
+    for (let row = 0; row <= rows; row++) {
+      const progress = row / rows;
+      const z = start + (end - start) * (cell + .10 + .80 * progress) / cells - length / 2;
+      for (const [column, offset] of [[0, -1], [.5, 0], [1, 1]]) {
+        const x = center + halfWidth * offset;
+        ray.ray.origin.set(x, 5, z);
+        const hit = ray.intersectObject(airframe, true)[0];
+        if (!hit) return null;
+        positions.push(x, hit.point.y + .055, z);
+        gaugeUV.push(column, cell + progress);
+      }
+      if (row) {
+        const i = base + (row - 1) * 3;
+        indices.push(i, i + 3, i + 1, i + 1, i + 3, i + 4,
+          i + 1, i + 4, i + 2, i + 2, i + 4, i + 5);
+      }
+    }
+  }
+  const geometry = new THREE.BufferGeometry();
+  geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
+  geometry.setAttribute('gaugeUV', new THREE.Float32BufferAttribute(gaugeUV, 2));
+  geometry.setIndex(indices);
+  return geometry;
+}
+
+export function createAirframeHull(geometry) {
+  return new THREE.Mesh(geometry, new THREE.ShaderMaterial({
+    toneMapped: false,
+    uniforms: {
+      hull: { value: 1 },
+      ink: { value: new THREE.Color('#112322') },
+      track: { value: new THREE.Color('#536767') },
+      healthy: { value: new THREE.Color('#b3fff1') },
+      critical: { value: new THREE.Color('#ff987d') },
+    },
+    vertexShader: `
+      attribute vec2 gaugeUV;
+      varying vec2 cellUV;
+      void main() {
+        cellUV = gaugeUV;
+        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
+      }
+    `,
+    fragmentShader: `
+      uniform float hull;
+      uniform vec3 ink, track, healthy, critical;
+      varying vec2 cellUV;
+      void main() {
+        float edge = abs(cellUV.x - 0.5);
+        float aa = max(fwidth(cellUV.x) * 0.45, 0.02);
+        float core = 1.0 - smoothstep(0.36 - aa, 0.36 + aa, edge);
+        float filled = step(cellUV.y, hull * 4.0);
+        vec3 lit = mix(healthy, critical, step(hull, 0.35));
+        gl_FragColor = vec4(mix(ink, mix(track, lit, filled), core), 1.0);
+        #include <colorspace_fragment>
+      }
+    `,
+  }));
+}
