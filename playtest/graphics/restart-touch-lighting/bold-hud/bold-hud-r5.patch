+function drawSlipstream(px, py, ux, uy, distance, color, panels) {
+  const { x, y } = game.player;
+  const ahead = x * ux + y * uy, across = y * ux - x * uy;
+  const start = 70, reach = Math.min(168, distance);
+  // Advect a handful of strands through a world-coordinate lattice. Moving
+  // the camera or pilot exposes new strands instead of dragging an icon.
+  const spacing = 66, laneWidth = 27;
+  const nearestLane = Math.round(across / laneWidth);
+  const phase = game.time * CONFIG.hudCourse.slipstreamSpeed;
+  ctx.fillStyle = color;
+  ctx.strokeStyle = '#142022';
+  ctx.lineWidth = 1.5;
+  for (let lane = nearestLane - 1; lane <= nearestLane + 1; lane++) {
+    const offset = lane * laneWidth - across;
+    const wave = phase + lane * 25 - ahead;
+    const first = start + ((wave - start) % spacing + spacing) % spacing;
+    for (let along = first; along < reach; along += spacing) {
+      const x = px + ux * along - uy * offset, y = py + uy * along + ux * offset;
+      const tailX = x - ux * 31, tailY = y - uy * 31;
+      if (!boxClear(Math.min(x, tailX) - 5, Math.min(y, tailY) - 5,
+          Math.abs(x - tailX) + 10, Math.abs(y - tailY) + 10, panels)) continue;
+      // Each strand thickens at its leading edge, so still frames retain a
+      // direction even where the color is close to the scenery underneath.
+      ctx.globalAlpha = .85 * Math.min(1, (along - start) / 12, (reach - along) / 14);
+      ctx.beginPath(); ctx.moveTo(tailX, tailY);
+      ctx.quadraticCurveTo(x - ux * 14 + uy * 5, y - uy * 14 - ux * 5, x, y);
+      ctx.lineTo(x - ux * 4 - uy * 2, y - uy * 4 + ux * 2);
+      ctx.quadraticCurveTo(x - ux * 15, y - uy * 15, tailX, tailY);
+      ctx.closePath(); ctx.stroke(); ctx.fill();
+    }
+  }
+  ctx.globalAlpha = 1;
+}
