+// Compare the page observer's actual callback arrivals with the compositor
+// timestamps already used for the MP4. Neither timeline measures presentation
+// on a physical display.
+function frameTiming(raf, frames, events, first) {
+  const majorGapSeconds = .05;
+  const cueWindowSeconds = .15;
+  const gapList = times => times.slice(1).map((end, i) => ({
+    startSeconds: times[i], endSeconds: end, durationSeconds: end - times[i],
+  }));
+  const rafCallbackSeconds = raf.map(sample => sample.arrival - first);
+  const observerGaps = gapList(rafCallbackSeconds);
+  const compositorGaps = gapList(frames.map(frame => frame.timestamp - first));
+  const overlap = (a, b) => Math.min(a.endSeconds, b.endSeconds) - Math.max(a.startSeconds, b.startSeconds);
+  const cuesNear = gap => events.map(event => ({
+    event: event.event,
+    dispatchSeconds: event.dispatchEpochSeconds - first,
+  })).filter(cue => cue.dispatchSeconds >= gap.startSeconds - cueWindowSeconds &&
+    cue.dispatchSeconds <= gap.endSeconds + cueWindowSeconds);
+  const observerMajorGaps = observerGaps.filter(gap => gap.durationSeconds >= majorGapSeconds);
+  return {
+    method: 'Additional page requestAnimationFrame observer beside the live game loop; callback entry sampled with performance.now().',
+    limitations: 'Observer delays suggest page scheduling or main-thread stalls, but do not isolate game CPU or GPU work. Compositor gaps with intervening observer callbacks show the recorder omitted visual updates from that interval or received no new composited pixels; they do not prove dropped display frames. CDP and page clocks are aligned by host epoch, approximately.',
+    callbackCount: raf.length,
+    scheduledSeconds: raf.map(sample => sample.scheduled - first),
+    callbackSeconds: rafCallbackSeconds,
+    maximumCallbackGapSeconds: Math.max(0, ...observerGaps.map(gap => gap.durationSeconds)),
+    majorGapSeconds,
+    cueWindowSeconds,
+    observerGaps: observerMajorGaps.map(gap => ({ ...gap, nearbyCues: cuesNear(gap) })),
+    compositorGaps: compositorGaps.filter(gap => gap.durationSeconds >= majorGapSeconds).map(gap => ({
+      ...gap,
+      callbacksInside: rafCallbackSeconds.filter(time => time > gap.startSeconds && time < gap.endSeconds).length,
+      overlappingObserverGapSeconds: Math.max(0, ...observerMajorGaps.map(observer => overlap(gap, observer))),
+      nearbyCues: cuesNear(gap),
+    })),
+  };
+}
