From 08676c4ce99b88c512cb0c51d8e2e9b1bb35cf0c Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sat, 7 Nov 2026 13:37:00 +0100
Subject: [PATCH] Reuse pressure and debris transients for explosion cues

---
 playtest/gun-audio.mjs |  41 +++++++++++++++--
 src/audio.js           | 101 +++++++++++++++++++++++++++++++++--------
 2 files changed, 118 insertions(+), 24 deletions(-)

diff --git a/playtest/gun-audio.mjs b/playtest/gun-audio.mjs
index 479a391..ae43a85 100644
--- a/playtest/gun-audio.mjs
+++ b/playtest/gun-audio.mjs
@@ -1,6 +1,6 @@
 import assert from 'node:assert/strict';
 import { test } from 'node:test';
-import { audioInit, sfxGun } from '../src/audio.js';
+import { audioInit, sfxBoom, sfxGun } from '../src/audio.js';
 import { rand, setSeed } from '../src/util.js';
 
 test('gunfire preserves gameplay RNG, reuses bounded transients and starts immediately', () => {
@@ -26,7 +26,8 @@ test('gunfire preserves gameplay RNG, reuses bounded transients and starts immed
     createBufferSource() {
       return {
         connect(target) { assert.equal(target, destination); },
-        start(time) { starts.push({ time, buffer: this.buffer }); },
+        disconnect() { this.disconnected = true; },
+        start(time) { starts.push({ time, buffer: this.buffer, source: this }); },
       };
     }
   }
@@ -34,6 +35,7 @@ test('gunfire preserves gameplay RNG, reuses bounded transients and starts immed
   setSeed(1942);
   const expected = Array.from({ length: 12 }, () => {
     sfxGun();
+    sfxBoom(false);
     return rand(0, 1);
   });
   globalThis.window = { AudioContext: TestAudioContext };
@@ -48,13 +50,13 @@ test('gunfire preserves gameplay RNG, reuses bounded transients and starts immed
     assert.deepEqual(actual, expected);
     assert.equal(resumes, 1);
     assert.equal(starts.length, 12);
-    assert.equal(buffers.length, 4);
+    assert.equal(buffers.length, 8);
     assert.equal(new Set(starts.map(({ buffer }) => buffer)).size, 4);
     for (const { time, buffer } of starts) {
       assert.equal(time, 3.5);
       assert.ok(buffers.includes(buffer));
     }
-    for (const { data, sampleRate } of buffers) {
+    for (const { data, sampleRate } of new Set(starts.map(({ buffer }) => buffer))) {
       assert.ok(data.length / sampleRate < .1, 'shot ends before the fastest player fire interval');
       assert.equal(Math.abs(data[0]), 0);
       assert.equal(Math.abs(data.at(-1)), 0);
@@ -65,6 +67,37 @@ test('gunfire preserves gameplay RNG, reuses bounded transients and starts immed
       const span = Math.round(sampleRate * .02);
       assert.ok(energy(data.subarray(0, span)) > 25 * energy(data.subarray(-span)));
     }
+
+    // A flood of small events must leave room for the major blast.
+    setSeed(1942);
+    const boomStarts = starts.length;
+    for (let i = 0; i < 12; i++) sfxBoom(false);
+    sfxBoom(true);
+    sfxBoom(true);
+    assert.equal(starts.length - boomStarts, 3);
+    const [smallA, smallB, largeA] = starts.slice(boomStarts);
+    assert.notEqual(smallA.buffer, smallB.buffer);
+    for (const { buffer, time } of [smallA, smallB, largeA]) {
+      assert.equal(time, 3.5);
+      assert.equal(Math.abs(buffer.data[0]), 0);
+      assert.equal(Math.abs(buffer.data.at(-1)), 0);
+      assert.ok(buffer.data.every(Number.isFinite));
+    }
+    assert.equal(smallA.buffer.data.length / smallA.buffer.sampleRate, .27);
+    assert.equal(largeA.buffer.data.length / largeA.buffer.sampleRate, .62);
+    const peak = ({ buffer }) => Math.max(...buffer.data.map(Math.abs));
+    assert.ok(peak(smallA) > .15 && peak(smallA) < .17);
+    assert.ok(peak(largeA) > .22 && peak(largeA) < .24);
+    smallA.source.onended();
+    largeA.source.onended();
+    assert.ok(smallA.source.disconnected && largeA.source.disconnected);
+    sfxBoom(false);
+    sfxBoom(true);
+    assert.equal(starts.length - boomStarts, 5);
+    assert.equal(starts.at(-2).buffer, smallA.buffer);
+    assert.notEqual(starts.at(-1).buffer, largeA.buffer);
+    assert.equal(buffers.length, 8, 'playing bursts must not allocate more PCM');
+    assert.deepEqual(Array.from({ length: 12 }, () => rand(0, 1)), expected);
   } finally {
     delete globalThis.window;
   }
diff --git a/src/audio.js b/src/audio.js
index 819ea36..5088fe5 100644
--- a/src/audio.js
+++ b/src/audio.js
@@ -2,18 +2,34 @@
 let AC = null;
 let gunShots;
 let nextGunShot = 0;
+let blasts;
+let activeBlasts = 0;
+let activeSmallBlasts = 0;
 
-const GUN_SAMPLE_RATE = 24000;
+const SAMPLE_RATE = 24000;
 const GUN_DURATION = .075;
 const GUN_PEAK = .08;
+const MAX_BLASTS = 3;
+
+function noiseStep(seed) {
+  return (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+}
+
+function filterStep(frequency) {
+  return 1 - Math.exp(-2 * Math.PI * frequency / SAMPLE_RATE);
+}
+
+function normalizePeak(samples, peak, target) {
+  const scale = target / peak;
+  for (let i = 0; i < samples.length; i++) samples[i] *= scale;
+}
 
 function createGunShot(context, seed) {
-  const length = Math.round(GUN_DURATION * GUN_SAMPLE_RATE);
-  const buffer = context.createBuffer(1, length, GUN_SAMPLE_RATE);
+  const length = Math.round(GUN_DURATION * SAMPLE_RATE);
+  const buffer = context.createBuffer(1, length, SAMPLE_RATE);
   const samples = buffer.getChannelData(0);
-  const smooth = frequency => 1 - Math.exp(-2 * Math.PI * frequency / GUN_SAMPLE_RATE);
-  const pressureBand = smooth(430);
-  const reportBand = smooth(2600);
+  const pressureBand = filterStep(430);
+  const reportBand = filterStep(2600);
   let pressure = 0;
   let report = 0;
   let peak = 0;
@@ -21,11 +37,11 @@ function createGunShot(context, seed) {
   for (let i = 0; i < length; i++) {
     // Each buffer has its own repeatable noise. Firing never draws from the
     // gameplay random stream, regardless of whether audio has been unlocked.
-    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    seed = noiseStep(seed);
     const noise = seed / 2147483648 - 1;
     pressure += pressureBand * (noise - pressure);
     report += reportBand * (noise - report);
-    const t = i / GUN_SAMPLE_RATE;
+    const t = i / SAMPLE_RATE;
     const crack = (report - pressure) * Math.exp(-t / .005);
     const body = pressure * Math.exp(-t / .014);
     const returnTime = t - .014;
@@ -36,15 +52,52 @@ function createGunShot(context, seed) {
     samples[i] = sample;
     peak = Math.max(peak, Math.abs(sample));
   }
-  const scale = GUN_PEAK / peak;
-  for (let i = 0; i < length; i++) samples[i] *= scale;
+  normalizePeak(samples, peak, GUN_PEAK);
+  return buffer;
+}
+
+function createBlast(context, seed, big) {
+  const length = Math.round((big ? .62 : .27) * SAMPLE_RATE);
+  const buffer = context.createBuffer(1, length, SAMPLE_RATE);
+  const samples = buffer.getChannelData(0);
+  // Keep the body in a band audible on small speakers. A brief higher crack
+  // leads each blast, and a slower, lower tail distinguishes the large cue.
+  const lowBand = filterStep(big ? 85 : 160);
+  const bodyBand = filterStep(big ? 390 : 730);
+  const debrisBand = filterStep(big ? 1300 : 2200);
+  let low = 0;
+  let body = 0;
+  let debris = 0;
+  let peak = 0;
+  for (let i = 0; i < length; i++) {
+    seed = noiseStep(seed);
+    const noise = seed / 2147483648 - 1;
+    low += lowBand * (noise - low);
+    body += bodyBand * (noise - body);
+    debris += debrisBand * (noise - debris);
+    const t = i / SAMPLE_RATE;
+    const crack = (debris - body) * Math.exp(-t / .012);
+    const pressure = (body - low) * Math.exp(-t / (big ? .118 : .044));
+    const tail = (debris - low) * Math.min(1, t / .035) * Math.exp(-t / (big ? .16 : .07));
+    const edge = Math.min(1, t / .001, (length - 1 - i) / (.025 * SAMPLE_RATE));
+    const sample = edge * (.55 * crack + pressure + .22 * tail);
+    samples[i] = sample;
+    peak = Math.max(peak, Math.abs(sample));
+  }
+  normalizePeak(samples, peak, big ? .23 : .16);
   return buffer;
 }
 
 export function audioInit() {
   if (!AC) {
     try { AC = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {}
-    if (AC) gunShots = [1942, 1943, 1944, 1945].map(seed => createGunShot(AC, seed));
+    if (AC) {
+      gunShots = [1942, 1943, 1944, 1945].map(seed => createGunShot(AC, seed));
+      blasts = [false, true].map(big => ({
+        buffers: [3221, 7319].map(seed => createBlast(AC, seed, big)),
+        next: 0,
+      }));
+    }
   }
   if (AC && AC.state === 'suspended') AC.resume();
 }
@@ -71,13 +124,21 @@ export function sfxOverheat() {
 }
 
 export function sfxBoom(big) {
-  if (!AC) return;
-  const t = AC.currentTime, len = big ? 0.7 : 0.4;
-  const buf = AC.createBuffer(1, AC.sampleRate * len, AC.sampleRate);
-  const d = buf.getChannelData(0);
-  for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / d.length, 2);
-  const src = AC.createBufferSource(); src.buffer = buf;
-  const f = AC.createBiquadFilter(); f.type = 'lowpass'; f.frequency.setValueAtTime(big ? 900 : 1400, t);
-  const g = AC.createGain(); g.gain.setValueAtTime(big ? 0.35 : 0.2, t);
-  src.connect(f).connect(g).connect(AC.destination); src.start(t);
+  // Leave one voice available for a large blast when small cues overlap.
+  // Even three full-scale blast voices sum to at most .69 before resampling.
+  if (!AC || AC.state !== 'running' || activeBlasts >= MAX_BLASTS ||
+      (!big && activeSmallBlasts >= MAX_BLASTS - 1)) return;
+  const bank = blasts[big ? 1 : 0];
+  const source = AC.createBufferSource();
+  source.buffer = bank.buffers[bank.next];
+  bank.next = (bank.next + 1) % bank.buffers.length;
+  activeBlasts++;
+  if (!big) activeSmallBlasts++;
+  source.onended = () => {
+    activeBlasts--;
+    if (!big) activeSmallBlasts--;
+    source.disconnect();
+  };
+  source.connect(AC.destination);
+  source.start(AC.currentTime);
 }
