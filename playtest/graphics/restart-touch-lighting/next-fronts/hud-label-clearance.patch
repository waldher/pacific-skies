--- /dev/null
+++ b/playtest/hud-labels.mjs
@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { wingLabelBaseline } from '../src/hud-labels.js';
+
+const view = { W: 852, H: 393 };
+const minimap = { x: 700, y: 12, w: 140, h: 84 };
+const objective = { x: 271, y: 12, w: 310, h: 22 };
+const hawk = { width: 28, actualBoundingBoxAscent: 7, actualBoundingBoxDescent: 1 };
+
+test('normal call signs keep their familiar position under the wingman', () => {
+  assert.equal(wingLabelBaseline(425, 160, hawk, view, [minimap, objective]), 190);
+});
+
+test('Hawk cannot label an aircraft clipped above the objective or hidden by the map', () => {
+  assert.equal(wingLabelBaseline(303, -13, hawk, view, [minimap, objective]), null);
+  assert.equal(wingLabelBaseline(708, 43, hawk, view, [minimap, objective]), null);
+  // Even if the projected text would clear the map, the aircraft is under it.
+  assert.equal(wingLabelBaseline(708, 84, hawk, view, [minimap, objective]), null);
+});
+
+test('glyph overhang cannot straddle a map edge even when its anchor is clear', () => {
+  const metrics = { ...hawk, width: 19, actualBoundingBoxRight: 15 };
+  assert.equal(wingLabelBaseline(683, 43, metrics, view, [minimap, objective]), null);
+  assert.equal(wingLabelBaseline(678, 43, metrics, view, [minimap, objective]), 73);
+});
+
+test('screen-edge fallbacks stay on-screen or hide the optional label', () => {
+  assert.equal(wingLabelBaseline(425, 380, hawk, view, [minimap, null]), 350);
+  assert.equal(wingLabelBaseline(8, 160, hawk, view, [minimap, null]), null);
+});
+
+test('portrait call signs avoid the full multi-row objective panel', () => {
+  const portrait = { W: 393, H: 852 };
+  const panel = { x: 14, y: 106, w: 310, h: 72 };
+  assert.equal(wingLabelBaseline(180, 93, hawk, portrait, [panel]), 63);
+  assert.equal(wingLabelBaseline(180, 192, hawk, portrait, [panel]), 222);
+});
diff --git a/src/hud-labels.js b/src/hud-labels.js
new file mode 100644
index 0000000..215de9e
--- /dev/null
+++ b/src/hud-labels.js
@@ -0,0 +1,22 @@
+// Keep optional call signs attached to visible wingmen. Use the original
+// below-aircraft slot first, flip vertically when it is blocked, or omit.
+export function wingLabelBaseline(x, y, metrics, view, panels) {
+  const margin = 3;
+  if (x < 0 || x >= view.W || y < 0 || y >= view.H) return null;
+  for (const panel of panels) {
+    if (panel && x >= panel.x && x < panel.x + panel.w &&
+        y >= panel.y && y < panel.y + panel.h) return null;
+  }
+  const halfWidth = Math.max(metrics.width / 2,
+    metrics.actualBoundingBoxLeft ?? 0, metrics.actualBoundingBoxRight ?? 0) + margin;
+  const left = x - halfWidth, right = x + halfWidth;
+  if (left < 0 || right > view.W) return null;
+  for (const baseline of [y + 30, y - 30]) {
+    const top = baseline - (metrics.actualBoundingBoxAscent ?? 9) - margin;
+    const bottom = baseline + (metrics.actualBoundingBoxDescent ?? 3) + margin;
+    if (top < 0 || bottom > view.H) continue;
+    if (!panels.some(panel => panel && left < panel.x + panel.w && right > panel.x &&
+        top < panel.y + panel.h && bottom > panel.y)) return baseline;
+  }
+  return null;
+}
