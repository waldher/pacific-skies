+// The Zero's opaque vertex paint can retain its diffuse light response without
+// the physical specular calculation. Cache one alternative per batch, shared
+// by every raider. Keep the original materials on the template for previews.
+const raiderDiffuseMaterials = new WeakMap();
+function raiderDiffuseMaterial(source) {
+  if (raiderDiffuseMaterials.has(source)) return raiderDiffuseMaterials.get(source);
+  const plainPaint = source.isMeshStandardMaterial && !source.isMeshPhysicalMaterial
+    && source.vertexColors && !source.transparent && !source.alphaTest
+    && !Object.keys(source).some(key => /(^map$|Map$)/.test(key) && source[key]);
+  if (!plainPaint) return source;
+  const material = new THREE.MeshLambertMaterial({
+    color: source.color.clone().multiplyScalar(1 - source.metalness),
+    emissive: source.emissive,
+    emissiveIntensity: source.emissiveIntensity,
+    side: source.side,
+    vertexColors: true,
+    toneMapped: source.toneMapped,
+  });
+  raiderDiffuseMaterials.set(source, material);
+  return material;
+}
