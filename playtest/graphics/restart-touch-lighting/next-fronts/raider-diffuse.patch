@@ -0,0 +1,64 @@
+// CPU-only check of material isolation and geometry reuse between aircraft.
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+
+const root = path.resolve(__dirname, '..');
+const three = path.join(root, 'vendor/three');
+const context = vm.createContext({ console });
+const modules = new Map();
+
+function load(file) {
+  if (!modules.has(file)) {
+    modules.set(file, new vm.SourceTextModule(fs.readFileSync(file, 'utf8'), {
+      context, identifier: file,
+    }));
+  }
+  return modules.get(file);
+}
+
+async function run() {
+  const aircraft = load(path.join(root, 'src/aircraft.js'));
+  await aircraft.link((specifier, importer) => {
+    if (specifier === 'three') return load(path.join(three, 'three.module.min.js'));
+    if (specifier.startsWith('three/addons/')) return load(path.join(three, specifier.slice(6)));
+    return load(path.resolve(path.dirname(importer.identifier), specifier));
+  });
+  await aircraft.evaluate();
+  const T = load(path.join(three, 'three.module.min.js')).namespace;
+  const { createAircraft, updateAircraft } = aircraft.namespace;
+  const template = new T.Group();
+  template.name = 'Mitsubishi_Zero';
+  const paint = new T.MeshStandardMaterial({
+    color: 0xa19f88, metalness: .12, side: T.DoubleSide, vertexColors: true,
+  });
+  const geometry = new T.BoxGeometry();
+  template.add(new T.Mesh(geometry, paint));
+  const propeller = new T.Mesh(geometry, paint);
+  propeller.name = 'Propeller';
+  template.add(propeller);
+  const entity = { x: 11, y: 22, a: .5, altitude: 32, hp: 10 };
+  const before = JSON.stringify(entity);
+  const first = createAircraft(template, entity, false, false, true);
+  const second = createAircraft(template, entity, false, false, true);
+  const material = first.model.children[0].material;
+  assert.ok(material.isMeshLambertMaterial);
+  assert.equal(first.model.children[0].geometry, geometry);
+  assert.equal(second.model.children[0].material, material);
+  assert.equal(template.children[0].material, paint);
+  assert.equal(createAircraft(template, entity).model.children[0].material, paint);
+  assert.equal(createAircraft(template, entity, false, true, true).model.children[0].material, paint);
+  assert.equal(material.side, paint.side);
+  assert.equal(material.color.r, paint.color.r * (1 - paint.metalness));
+
+  const textured = new T.MeshStandardMaterial({ map: new T.Texture(), vertexColors: true });
+  template.children[0].material = textured;
+  assert.equal(createAircraft(template, entity, false, false, true).model.children[0].material, textured);
+  updateAircraft(first, entity, .016, 1);
+  assert.notEqual(first.propeller.rotation.z, 0);
+  assert.equal(JSON.stringify(entity), before);
+  console.log('PASS touch raiders share diffuse paint without changing templates, models or flight state');
+}
+
+run().catch(error => { console.error(error); process.exitCode = 1; });
