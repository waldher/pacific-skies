+function drawPilotMarker(player) {
+  if (game.mode !== 'play') return;
+  const bottom = pilotMarkerOffset(player);
+  if (bottom === undefined) return;
+  const [x, centerY] = w2s(player.x, player.y, aircraftHeight(player));
+  // A 6px gap leaves clear space even with the 5px dark keyline.
+  // The marker stays screen-upright and disappears if its bounds clip.
+  const y = centerY + bottom + 6;
+  if (x < 8 || x > view.W - 8 || y < 3 || y > view.H - 8) return;
+  ctx.save();
+  ctx.lineJoin = ctx.lineCap = 'round';
+  ctx.beginPath();
+  ctx.moveTo(x - 5, y + 4); ctx.lineTo(x, y); ctx.lineTo(x + 5, y + 4);
+  ctx.strokeStyle = '#071a22'; ctx.lineWidth = 5; ctx.stroke();
+  ctx.strokeStyle = '#a5f1dc'; ctx.lineWidth = 2; ctx.stroke();
